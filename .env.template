# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration
DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<YOUR-AZURE-POSTGRES-HOST>:5432/<POSTGRES_DB>?schema=public&sslmode=require"

# Redis Configuration (if using Azure Cache for Redis)
REDIS_URL="rediss://<YOUR-REDIS-NAME>.redis.cache.windows.net:6380?password=<YOUR-ACCESS-KEY>"

# API Keys
OPENAI_API_KEY="Your OpenAI API Key"
GROQ_API_KEY="Your GROQ API Key"

# Auth Configuration
GOOGLE_CLIENT_ID="Your Google Client ID"
GOOGLE_CLIENT_SECRET="Your Google Client Secret"
SESSION_SECRET="Your Session Secret"
JWT_SECRET="Your JWT Secret"
REDIRECT_URL_FRONTEND="https://your-frontend-domain.com"

# Azure Configuration
AZURE_TENANT_ID="Your Azure Tenant ID"
AZURE_CLIENT_ID="Your Azure Client ID"
AZURE_CLIENT_SECRET="Your Azure Client Secret"

POSTGRES_USER="Your Postgres User"
POSTGRES_PASSWORD="Your Postgres Password"
POSTGRES_DB="Your Postgres DB"